{
  // The package name, as declared in pubspec.yaml / package.json.
  "name": "@rljson/io-sqlite-node",

  // 1-2 sentence summary about this repo.
  "summary": "Io on SQLite for Node (node:sqlite DatabaseSync): IoSqliteNode keeps Rljson tables in a database file, or in memory without file name; SqlStatements builds the SQL.",

  // 1-3 bullet points: the problem space.
  "domain": [
    "persistent Io in a SQLite file: open/create, delete, raw SQL (execute)",
    "Rljson tables and tableCfgs as SQL tables (SqlStatements, IoDbNameMapping)",
    "io conformance suite"
  ],

  // The repos this one depends on and the repos depending on it.
  // Keep the reason or the API behind each entry, not just the name.
  "interfaces": {
    // "<repo-a>": "why / API"
    "uses": {
      "io": "Io, IoTools, IoDbNameMapping; test: conformance suite (IoTestSetup)",
      "rljson": "Rljson, TableCfg, ColumnCfg, ContentType, iterateTables",
      "hash": "hip/hsh: written rows, tableCfgs",
      "is-ready": "IsReady: isReady() after init",
      "json": "Json types"
    },

    // "<repo-b>": "why / API"
    "usedBy": {}
  }
}
