{
  "name": "@rljson/io-sqlite-node",
  "version": "1.0.9",
  "description": "IoSql rljson files",
  "homepage": "https://github.com/rljson/io-sqlite_node",
  "bugs": "https://github.com/rljson/io-sqlite-node/issues",
  "private": false,
  "license": "MIT",
  "engines": {
    "node": ">=22.14.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rljson/io-sqlite-node.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "pnpm vite build && tsc && node scripts/copy-readme-to-dist.js && node scripts/copy-file.js src/example.ts dist/src",
    "test": "pnpm installConformanceTests && pnpm vitest --coverage --no-file-parallelism --run  && pnpm run lint",
    "prebuild": "pnpm run test",
    "prepublishOnly": "pnpm run build",
    "lint": "pnpm eslint",
    "updateGoldens": "cross-env UPDATE_GOLDENS=true pnpm test",
    "installConformanceTests": "node scripts/install-conformance-tests.js"
  },
  "devDependencies": {
    "@rljson/dna-rljson": "^0.3.1",
    "@tssuite/helix-js": "^0.5.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/sql.js": "^1.4.11",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "^5.0.5",
    "cross-env": "^10.1.0",
    "eslint": "^10.13.0",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-tsdoc": "^0.5.4",
    "globals": "^17.13.0",
    "jsdoc": "^4.0.5",
    "read-pkg": "^10.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-node": "^6.0.0",
    "vite-plugin-dts": "^5.1.2",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5",
    "vitest-dom": "^0.1.1"
  },
  "dependencies": {
    "@rljson/hash": "^0.0.20",
    "@rljson/io": "^0.0.86",
    "@rljson/is-ready": "^0.0.20",
    "@rljson/json": "^0.0.23",
    "@rljson/rljson": "^0.0.87",
    "path-browserify": "^1.0.1",
    "shx": "^0.4.0",
    "sql.js": "^1.15.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.21.0"
}
